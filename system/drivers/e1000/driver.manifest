# Intel PRO/1000 Ethernet: 8254x and 8257x families (and most hypervisors);
# the I21x chips of recent PCs use the same rings but are not verified.
name        = e1000
version     = 1.0.0
class       = network
description = Intel PRO/1000 Ethernet
author      = arcOS
match       = pci 8086:100e     # 82540EM (QEMU, VirtualBox)
match       = pci 8086:100f     # 82545EM (VMware)
match       = pci 8086:1004     # 82543GC
match       = pci 8086:100c     # 82544GC
match       = pci 8086:1015     # 82540EM LOM
match       = pci 8086:1019     # 82547EI
match       = pci 8086:101e     # 82540EP
match       = pci 8086:1026     # 82545GM
match       = pci 8086:1076     # 82541GI
match       = pci 8086:107c     # 82541PI
match       = pci 8086:10d3     # 82574L (QEMU q35)
match       = pci 8086:10f5     # 82567LM
match       = pci 8086:1079     # 82546GB
match       = pci 8086:107d     # 82572EI
match       = pci 8086:107e     # 82572EI
match       = pci 8086:107f     # 82572EI
match       = pci 8086:105e     # 82571EB
match       = pci 8086:105f     # 82571EB
match       = pci 8086:1060     # 82571EB
match       = pci 8086:108b     # 82573V
match       = pci 8086:108c     # 82573E
match       = pci 8086:109a     # 82573L
match       = pci 8086:10b9     # 82572EI
match       = pci 8086:10d6     # 82566 (not verified on hardware)
match       = pci 8086:10f6     # 82574LA
match       = pci 8086:150c     # 82583V
match       = pci 8086:10ea     # 82577LM (not verified on hardware)
match       = pci 8086:10ef     # 82578DM (not verified on hardware)
match       = pci 8086:1502     # 82579LM (not verified on hardware)
match       = pci 8086:1503     # 82579V (not verified on hardware)
match       = pci 8086:153a     # I217-LM (not verified on hardware)
match       = pci 8086:153b     # I217-V (not verified on hardware)
match       = pci 8086:155a     # I218-LM (not verified on hardware)
match       = pci 8086:1559     # I218-V (not verified on hardware)
match       = pci 8086:15a0     # I218-LM (not verified on hardware)
match       = pci 8086:15a1     # I218-V (not verified on hardware)
match       = pci 8086:156f     # I219-LM (not verified on hardware)
match       = pci 8086:1570     # I219-V (not verified on hardware)
match       = pci 8086:15b7     # I219-LM (not verified on hardware)
match       = pci 8086:15b8     # I219-V (not verified on hardware)
match       = pci 8086:15bb     # I219-LM (not verified on hardware)
match       = pci 8086:15bc     # I219-V (not verified on hardware)
match       = pci 8086:15d7     # I219-LM (not verified on hardware)
match       = pci 8086:15d8     # I219-V (not verified on hardware)
match       = pci 8086:15e3     # I219-LM (not verified on hardware)
match       = pci 8086:0d4e     # I219-LM (not verified on hardware)
match       = pci 8086:0d4f     # I219-V (not verified on hardware)
match       = pci 8086:15fb     # I219-LM (not verified on hardware)
match       = pci 8086:15fc     # I219-V (not verified on hardware)
