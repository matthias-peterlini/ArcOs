# The display of QEMU (standard VGA, bochs-display and QXL), Bochs and
# VirtualBox (VBoxVGA, VBoxSVGA): any resolution the video memory holds.
name        = bochsvga
version     = 1.1.0
class       = display
description = QEMU, Bochs and VirtualBox display
author      = arcOS
match       = pci 1234:1111     # QEMU standard VGA, bochs-display
match       = pci 80ee:beef     # VirtualBox VBoxVGA and VBoxSVGA
match       = pci 1b36:0100     # QXL (QEMU with SPICE), in VGA mode
