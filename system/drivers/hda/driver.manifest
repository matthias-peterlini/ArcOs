# Intel High Definition Audio: the sound of nearly every PC since 2005
# (Realtek, Conexant, IDT, VIA, Cirrus codecs behind Intel, AMD and NVIDIA
# controllers), and of QEMU and VirtualBox.
name        = hda
version     = 1.0.0
class       = audio
description = HD Audio sound
author      = arcOS
match       = pci-class 04:03
